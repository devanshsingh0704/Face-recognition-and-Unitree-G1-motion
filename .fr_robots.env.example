# Robot addresses and SSH login. Copy to ~/.fr_robots.env and fill in.
#
#     cp .fr_robots.env.example ~/.fr_robots.env
#     chmod 600 ~/.fr_robots.env
#
# Kept outside the repository on purpose: these are the credentials to a
# machine that can walk. Nothing in the tracked tree carries a real address or
# password, so the repo stays safe to publish.
#
# ONLY the remote modes need this -- `./start.sh --g1`, `--wifi`, `--ethernet`,
# and anything using scripts/go2.py. Running on the robot itself with
# `./start.sh --local` reads none of it.
#
# The environment wins over this file, so a one-off works too:
#     FR_HOST_G1=10.0.0.5 ./start.sh --g1

# SSH account. Unitree ships every robot with the same account name, so this is
# documentation rather than a secret.
FR_USER=unitree

# SSH password. There is deliberately no default anywhere in the code -- the
# scripts fail with instructions instead of trying a guessable one.
FR_PASSWORD=

# G1 humanoid, over wifi. The primary deployment target.
FR_HOST_G1=

# Go2 quadruped (legacy). It has two addresses and which one answers depends on
# how the laptop is attached, so both are listed.
FR_HOST_GO2=
FR_HOST_GO2_ETH=
